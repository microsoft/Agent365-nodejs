{
  "name": "@microsoft/agent365-monorepo",
  "version": "0.0.0-placeholder",
  "description": "Microsoft Agent 365 SDK monorepo for AI agents built with TypeScript/Node.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:watch": "pnpm -r --if-present run build:watch",
    "clean": "pnpm -r --if-present run clean",
    "test": "pnpm --filter @microsoft/agents-a365-tests test",
    "test:coverage": "pnpm --filter @microsoft/agents-a365-tests test:coverage",
    "test:watch": "pnpm --filter @microsoft/agents-a365-tests test:watch",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "typecheck": "pnpm -r --fail-if-no-match --filter \"./packages/**\" exec tsc --project tsconfig.cjs.json --noEmit && pnpm -r --fail-if-no-match --filter \"./packages/**\" exec tsc --project tsconfig.esm.json --noEmit",
    "ci": "pnpm install --frozen-lockfile",
    "pack": "node packPackages.js",
    "version": "node setVersion.js",
    "version:local": "node setVersion.js --local",
    "version:check": "node setVersion.js --dry-run"
  },
  "workspaces": [
    "packages/agents-a365-notifications",
    "packages/agents-a365-runtime",
    "packages/agents-a365-tooling",
    "packages/agents-a365-tooling-extensions-claude",
    "packages/agents-a365-tooling-extensions-langchain",
    "packages/agents-a365-tooling-extensions-openai",
    "tests"
  ],
  "keywords": [
    "ai",
    "agents",
    "azure",
    "typescript",
    "microsoft-365"
  ],
  "author": "Microsoft Corporation",
  "license": "See license file",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/Agent365.git",
    "directory": "nodejs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nerdbank-gitversioning": "^3.9.50",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "dependencies": {
    "globals": "^16.5.0",
    "jiti": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "^1.14.4",
      "@types/uuid": "^9.0.8",
      "axios": "^1.16.0",
      "fast-uri": "^3.1.2",
      "hono": "^4.13.5",
      "langsmith": "^0.8.0",
      "protobufjs": "^7.5.6",
      "uuid": "^11.1.1",
      "ws": "^8.21.3",
      "zod": "^4.1.12"
    }
  }
}
